{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corum exact wiki finalization payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "course", "sources", "applied", "failures"],
  "properties": {
    "version": {"const": 2},
    "run_id": {"type": "string", "pattern": "^\\S+$"},
    "course": {"type": "string", "pattern": "^\\S+$"},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "applied": {
      "type": "array",
      "items": {"$ref": "#/$defs/applied"}
    },
    "failures": {
      "type": "array",
      "items": {"$ref": "#/$defs/failure"}
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "identifier": {"type": "string", "pattern": "^\\S+$"},
    "sourceIds": {
      "type": "array",
      "items": {"$ref": "#/$defs/identifier"},
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "path": {"$ref": "#/$defs/relativePath"},
        "provenance": {
          "oneOf": [
            {"type": "string", "pattern": "\\S"},
            {"type": "null"}
          ]
        }
      }
    },
    "applied": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "path", "source_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "action": {"enum": ["create", "enrich", "index", "skip"]},
        "path": {"$ref": "#/$defs/relativePath"},
        "source_ids": {"$ref": "#/$defs/sourceIds"}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "path",
        "source_ids",
        "error",
        "write_state",
        "retry_safe"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "action": {"enum": ["create", "enrich", "index", "skip", "finalize"]},
        "path": {
          "oneOf": [
            {"$ref": "#/$defs/relativePath"},
            {"type": "null"}
          ]
        },
        "source_ids": {"$ref": "#/$defs/sourceIds"},
        "error": {"type": "string", "minLength": 1},
        "write_state": {"enum": ["not_applied", "applied", "unknown"]},
        "retry_safe": {"type": "boolean"}
      }
    }
  }
}
