{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corum workspace configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace"
  ],
  "properties": {
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "term"
      ],
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "term": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@]+/?$"
        }
      }
    },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cloud_id",
        "project"
      ],
      "properties": {
        "cloud_id": {
          "type": "string",
          "pattern": "^\\S+$"
        },
        "project": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      }
    }
  }
}
