{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corum workspace configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "workspace", "calendar"],
  "properties": {
    "version": {"const": 2},
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "term"],
      "properties": {
        "timezone": {"type": "string", "minLength": 1},
        "term": {"type": "string", "minLength": 1}
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://[^/?#@]+/?$"}
      }
    },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cloud_id", "project"],
      "properties": {
        "cloud_id": {"type": "string", "pattern": "\\S"},
        "project": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "transitions": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/credentialFreeKey"},
          "additionalProperties": {"type": "string", "pattern": "^[0-9]+$"}
        }
      }
    },
    "wiki": {"type": "object", "additionalProperties": false, "properties": {}},
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timetable", "term"],
      "properties": {
        "timetable": {"$ref": "#/$defs/relativePath"},
        "term": {"$ref": "#/$defs/relativePath"}
      }
    }
  },
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "credentialFreeKey": {"type": "string", "allOf": [{"pattern": "^\\S+$"}, {"not": {"pattern": "(?:^|[_-])(?:[Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Aa][Pp][Ii][^A-Za-z0-9]?[Kk][Ee][Yy]|[Aa][Cc][Cc][Ee][Ss][Ss][^A-Za-z0-9]?[Tt][Oo][Kk][Ee][Nn]|[Cc][Ll][Ii][Ee][Nn][Tt][^A-Za-z0-9]?[Ss][Ee][Cc][Rr][Ee][Tt]|[Cc][Aa][Nn][Vv][Aa][Ss][^A-Za-z0-9]?[Tt][Oo][Kk][Ee][Nn]|[Jj][Ii][Rr][Aa][^A-Za-z0-9]?[Tt][Oo][Kk][Ee][Nn])(?:[_-]|$)"}}]}
  }
}
