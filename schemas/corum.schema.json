{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corum workspace configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workspace", "canvas", "calendar"],
  "properties": {
    "schema": {"const": 1},
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "term"],
      "properties": {
        "timezone": {"type": "string", "minLength": 1},
        "term": {"type": "string"}
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host"],
      "properties": {
        "host": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@]+/?$"
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jira": {"$ref": "#/$defs/featureSwitch"},
        "wiki": {"$ref": "#/$defs/featureSwitch"}
      }
    },
    "jira": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["project"],
      "properties": {
        "cloud_id": {"type": ["string", "null"], "pattern": ".*\\S.*"},
        "site": {
          "type": ["string", "null"],
          "format": "uri",
          "pattern": "^https://[^/?#@]+/?$"
        },
        "project": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "transitions": {
          "type": "object",
          "propertyNames": {
            "allOf": [
              {"pattern": "^\\S+$"},
              {"$ref": "#/$defs/credentialFreeKey"}
            ]
          },
          "additionalProperties": {"type": "string", "pattern": "^[0-9]+$"}
        }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timetable", "term"],
      "properties": {"timetable": {"type": "string"}, "term": {"type": "string"}}
    }
  },
  "$defs": {
    "featureSwitch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}}
    },
    "credentialFreeKey": {
      "type": "string",
      "not": {
        "pattern": "(?:^|[_-])(?:[Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Aa][Pp][Ii][^A-Za-z0-9]?[Kk][Ee][Yy]|[Aa][Cc][Cc][Ee][Ss][Ss][^A-Za-z0-9]?[Tt][Oo][Kk][Ee][Nn]|[Cc][Ll][Ii][Ee][Nn][Tt][^A-Za-z0-9]?[Ss][Ee][Cc][Rr][Ee][Tt]|[Cc][Aa][Nn][Vv][Aa][Ss][^A-Za-z0-9]?[Tt][Oo][Kk][Ee][Nn]|[Jj][Ii][Rr][Aa][^A-Za-z0-9]?[Tt][Oo][Kk][Ee][Nn])(?:[_-]|$)"
      }
    }
  }
}
