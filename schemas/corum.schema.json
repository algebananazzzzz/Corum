{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corum workspace configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace"
  ],
  "properties": {
    "task_tracker": {"enum": ["none", "jira", "kaneo", "google_tasks"]},
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "term"
      ],
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "term": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@]+/?$"
        }
      }
    },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site"
      ],
      "properties": {
        "site": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@]+/?$"
        },
        "project": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      }
    },
    "kaneo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@]+/?$"
        },
        "project": {
          "type": "string",
          "pattern": "^\\S+$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "task_tracker"
        ],
        "properties": {
          "task_tracker": {
            "const": "jira"
          }
        }
      },
      "then": {
        "required": [
          "jira"
        ]
      }
    },
    {
      "if": {
        "required": [
          "task_tracker"
        ],
        "properties": {
          "task_tracker": {
            "const": "kaneo"
          }
        }
      },
      "then": {
        "required": [
          "kaneo"
        ]
      }
    },
    {
      "if": {
        "required": [
          "jira"
        ]
      },
      "then": {
        "required": [
          "task_tracker"
        ],
        "properties": {
          "task_tracker": {
            "const": "jira"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "kaneo"
        ]
      },
      "then": {
        "required": [
          "task_tracker"
        ],
        "properties": {
          "task_tracker": {
            "const": "kaneo"
          }
        }
      }
    }
  ]
}
