{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corum wiki source-ingestion state v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "ingested"],
  "properties": {
    "version": {"const": 2},
    "ingested": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "minLength": 1, "pattern": "\\S"},
          {"type": "null"}
        ]
      }
    }
  }
}
