{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corum exact Jira application plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "course", "epic", "actions"],
  "properties": {
    "version": {"const": 2},
    "course": {"type": "string", "pattern": "^\\S+$"},
    "epic": {"$ref": "#/$defs/issueKey"},
    "actions": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/create"},
          {"$ref": "#/$defs/update"},
          {"$ref": "#/$defs/transition"}
        ]
      }
    }
  },
  "$defs": {
    "issueKey": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[1-9][0-9]*$"},
    "nonBlank": {"type": "string", "pattern": "\\S"},
    "identifier": {"type": "string", "pattern": "^\\S+$"},
    "issueType": {"enum": ["Task", "Session", "Milestone"]},
    "labels": {"type": ["array", "null"], "items": {"type": "string"}},
    "createFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parent", "summary"],
      "properties": {
        "type": {"$ref": "#/$defs/issueType"},
        "parent": {"$ref": "#/$defs/issueKey"},
        "summary": {"$ref": "#/$defs/nonBlank"},
        "description": {"type": ["string", "null"]},
        "due": {"type": ["string", "null"], "format": "date"},
        "labels": {"$ref": "#/$defs/labels"}
      }
    },
    "updateFields": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "type": {"$ref": "#/$defs/issueType"},
        "parent": {"$ref": "#/$defs/issueKey"},
        "summary": {"$ref": "#/$defs/nonBlank"},
        "description": {"type": ["string", "null"]},
        "due": {"type": ["string", "null"], "format": "date"},
        "labels": {"$ref": "#/$defs/labels"}
      }
    },
    "create": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "issue"],
      "properties": {
        "action": {"const": "create"},
        "issue": {"$ref": "#/$defs/createFields"}
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "key", "set"],
      "properties": {
        "action": {"const": "update"},
        "key": {"$ref": "#/$defs/issueKey"},
        "set": {"$ref": "#/$defs/updateFields"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "key", "transition"],
      "properties": {
        "action": {"const": "transition"},
        "key": {"$ref": "#/$defs/issueKey"},
        "transition": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
