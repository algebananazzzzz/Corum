{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corum Canvas capture state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "synced_at", "sources"],
  "properties": {
    "schema": {"const": 1},
    "synced_at": {"type": ["string", "null"]},
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "announcements": {"$ref": "#/$defs/ledger"},
        "assignments": {"$ref": "#/$defs/ledger"},
        "files": {"$ref": "#/$defs/ledger"},
        "pages": {"$ref": "#/$defs/ledger"},
        "modules": {"$ref": "#/$defs/ledger"},
        "syllabus": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "ledger": {
      "type": "object",
      "additionalProperties": {"type": ["string", "null"]}
    }
  }
}
