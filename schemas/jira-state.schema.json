{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corum Jira state v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "reconciled_at", "issues"],
  "properties": {
    "version": {"const": 2},
    "reconciled_at": {"type": ["string", "null"], "format": "date-time"},
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "summary", "status", "due", "labels", "description", "updated_at"],
      "properties": {
        "key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[1-9][0-9]*$"},
        "type": {"type": "string", "pattern": "\\S"},
        "summary": {"type": "string", "pattern": "\\S"},
        "status": {"type": "string", "pattern": "\\S"},
        "due": {"type": ["string", "null"], "format": "date"},
        "labels": {
          "oneOf": [
            {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            {"type": "null"}
          ]
        },
        "description": {"type": ["string", "null"]},
        "updated_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
