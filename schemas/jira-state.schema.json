{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corum Jira state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issues"
  ],
  "properties": {
    "reconciled_at": {
      "type": "string",
      "format": "date-time"
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "summary",
        "status"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*-[1-9][0-9]*$"
        },
        "type": {
          "type": "string",
          "pattern": "\\S"
        },
        "summary": {
          "type": "string",
          "pattern": "\\S"
        },
        "status": {
          "type": "string",
          "pattern": "\\S"
        },
        "due": {
          "type": "string",
          "format": "date"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
