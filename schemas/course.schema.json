{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corum course configuration",
  "type": "object",
  "required": ["schema", "code", "canvas"],
  "properties": {
    "schema": {"const": 1},
    "code": {"type": "string"},
    "canvas": {
      "type": "object",
      "required": ["id", "sources"],
      "properties": {
        "id": {"type": "integer", "exclusiveMinimum": 0},
        "sources": {
          "type": "array",
          "items": {"enum": ["announcements", "assignments", "files", "pages", "modules", "syllabus"]}
        },
        "folders": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "features": {"type": "object"},
    "jira": {
      "type": "object",
      "required": ["epic"],
      "properties": {
        "epic": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[1-9][0-9]*$"}
      }
    },
    "wiki": {"type": "object", "properties": {"split_rules": {"type": "string"}}}
  }
}
