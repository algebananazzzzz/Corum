{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corum run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "course", "effective_features", "canvas", "jira", "wiki"],
  "properties": {
    "schema": {"const": 1},
    "run_id": {"type": "string"},
    "course": {"type": "string"},
    "effective_features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jira", "wiki"],
      "properties": {"jira": {"type": "boolean"}, "wiki": {"type": "boolean"}}
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "changes", "failures"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "summary"],
            "properties": {"kind": {"type": "string"}, "summary": {"type": "string"}}
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "error"],
            "properties": {"source": {"type": "string"}, "error": {"type": "string"}}
          }
        }
      }
    },
    "jira": {"$ref": "#/$defs/stage"},
    "wiki": {"$ref": "#/$defs/stage"}
  },
  "$defs": {
    "status": {
      "enum": ["disabled", "pending", "up_to_date", "changed", "applied", "partial", "failed"]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {"status": {"$ref": "#/$defs/status"}}
    }
  }
}
