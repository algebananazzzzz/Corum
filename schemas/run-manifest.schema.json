{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corum run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "course", "effective_features", "canvas", "jira", "wiki"],
  "properties": {
    "schema": {"const": 1},
    "run_id": {"type": "string"},
    "course": {"type": "string"},
    "effective_features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jira", "wiki"],
      "properties": {"jira": {"type": "boolean"}, "wiki": {"type": "boolean"}}
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "changes", "failures"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "summary"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "item_id": {"type": ["string", "null"]},
              "kind": {"type": "string"},
              "status": {"const": "changed"},
              "summary": {"type": "string"},
              "raw_path": {"type": ["string", "null"]},
              "details": {"type": "object"}
            }
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "error"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "item_id": {"type": ["string", "null"]},
              "kind": {"type": "string"},
              "status": {"const": "failed"},
              "error": {"type": "string"},
              "raw_path": {"type": ["string", "null"]},
              "details": {"type": "object"}
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "status", "changes", "failures"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "status": {"enum": ["up_to_date", "changed", "partial", "failed"]},
              "changes": {"type": "array", "items": {"type": "string"}},
              "failures": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "jira": {"$ref": "#/$defs/stage"},
    "wiki": {"$ref": "#/$defs/stage"}
  },
  "$defs": {
    "status": {
      "enum": ["disabled", "pending", "up_to_date", "changed", "applied", "partial", "failed"]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "applied": {
          "type": "array",
          "items": {"$ref": "#/$defs/appliedItem"}
        },
        "failures": {
          "type": "array",
          "items": {"$ref": "#/$defs/stageFailure"}
        },
        "reconciliation_required": {"type": "boolean"},
        "retry_safe": {"type": "boolean"},
        "reconciled": {"type": "boolean"}
      }
    },
    "appliedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "target"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "details": {"type": "object"}
      }
    },
    "stageFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "error"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "action": {"type": ["string", "null"]},
        "target": {"type": ["string", "null"]},
        "error": {"type": "string"},
        "write_state": {"enum": ["not_applied", "applied", "unknown"]},
        "retry_safe": {"type": "boolean"},
        "details": {"type": "object"}
      }
    }
  }
}
